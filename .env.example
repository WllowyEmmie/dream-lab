# Copy to .env and fill in. .env is git-ignored; never commit the real URL.
# Slack incoming webhook for dreaming reports (AI-15). Leave empty to skip Slack.
SLACK_WEBHOOK_URL=
# Optional. Auto-merge dreaming when the judge scores at least this (1-5). Default 4.
# DREAM_MERGE_THRESHOLD=4
# Optional. Max size of memory/ in tokens (about 4 characters each). Default 2000.
# DREAM_MEMORY_BUDGET=2000
